{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Only what Typist Wall uses: its own commands, drag-and-drop events and the open dialog.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-monitors",
    "allow-read-file",
    "allow-save-png",
    "allow-save-sidecar",
    "allow-set-wallpaper",
    "allow-add-to-theme-backgrounds",
    "allow-theme-colors",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open"
  ]
}
