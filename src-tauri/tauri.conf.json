{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Typist Wall",
  "mainBinaryName": "typist-wall",
  "version": "0.1.0",
  "identifier": "dev.kivan.typist-wall",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Typist Wall",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "dragDropEnabled": true,
        "backgroundColor": "#141416"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "category": "Graphics",
    "shortDescription": "Photo to text-art wallpaper",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
