{
  "name": "stipple",
  "version": "1.0.0",
  "description": "Turn a photo into a text-art wallpaper for Omarchy, with the Typist engine.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test src/lib/doc.test.ts src/lib/layout.test.ts src/lib/motion.test.ts src/lib/letterframes.test.ts src/lib/palette.test.ts src/lib/engine",
    "test:engine": "node --test 'src/lib/typist/tests/*.test.mjs'",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "@tauri-apps/api": "3.0.0-alpha.1",
    "@tauri-apps/plugin-dialog": "3.0.0-alpha.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "3.0.0-alpha.2",
    "@types/bun": "1.4.2",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  }
}
